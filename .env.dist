###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ChangeMe_SecretKey_ForProduction_Min32Chars
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://sylius:sylius_password@postgres:5432/eletroposto?serverVersion=15&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailhog:1025
MAILER_FROM=noreply@eletroposto.com.br
###< symfony/mailer ###

###> Redis ###
REDIS_URL=redis://redis:6379
REDIS_CACHE_DSN=redis://redis:6379/1
REDIS_SESSION_DSN=redis://redis:6379/2
###< Redis ###

###> WebSocket Server (OCPP) ###
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=9000
###< WebSocket Server ###

###> sylius/sylius ###
SYLIUS_ADMIN_EMAIL=admin@eletroposto.com.br
SYLIUS_ADMIN_PASSWORD=admin123
###< sylius/sylius ###

###> API Configuration ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=ChangeMe_JWT_Passphrase
JWT_TOKEN_TTL=3600
###< API Configuration ###

###> Payment Gateway ###
# Stripe
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# PagSeguro
PAGSEGURO_EMAIL=seu-email@example.com
PAGSEGURO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
PAGSEGURO_ENVIRONMENT=sandbox

# Mercado Pago
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
###< Payment Gateway ###

###> OCPP Configuration ###
OCPP_VERSION=1.6
OCPP_HEARTBEAT_INTERVAL=300
OCPP_METER_VALUE_INTERVAL=60
OCPP_CONNECTION_TIMEOUT=30
###< OCPP Configuration ###

###> Maps API ###
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
###< Maps API ###

###> AWS S3 (opcional) ###
# AWS_S3_BUCKET=eletroposto-uploads
# AWS_S3_REGION=sa-east-1
# AWS_S3_KEY=your_aws_key
# AWS_S3_SECRET=your_aws_secret
###< AWS S3 ###

###> Monitoring (opcional) ###
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
###< Monitoring ###
