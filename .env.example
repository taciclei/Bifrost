# 🌈⚡ Bifrost - Environment Variables
# Copy this file to .env and customize for your environment

# =====================================
# Application
# =====================================
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=!ChangeMe_GenerateRandomSecret!

# =====================================
# Database (PostgreSQL)
# =====================================
POSTGRES_DB=bifrost
POSTGRES_USER=bifrost
POSTGRES_PASSWORD=bifrost
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?serverVersion=16&charset=utf8

# =====================================
# Redis
# =====================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# =====================================
# Mercure Hub (Real-time)
# =====================================
MERCURE_URL=http://localhost/.well-known/mercure
MERCURE_PUBLIC_URL=https://localhost/.well-known/mercure
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!

# =====================================
# API Platform
# =====================================
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# =====================================
# FrankenPHP / Caddy
# =====================================
SERVER_NAME=localhost, caddy:80
CADDY_GLOBAL_OPTIONS=
FRANKENPHP_CONFIG=worker ./public/index.php

# Logging
LOG_FORMAT=console

# =====================================
# Mailer
# =====================================
MAILER_DSN=smtp://mailhog:1025
MAILER_FROM=noreply@bifrost.local

# =====================================
# Messenger (Async Processing)
# =====================================
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# =====================================
# OCPP Configuration
# =====================================
OCPP_VERSION=1.6
OCPP_SUPPORTED_VERSIONS=1.6,2.0.1
OCPP_WEBSOCKET_HOST=0.0.0.0
OCPP_WEBSOCKET_PORT=9000
OCPP_WSS_PORT=9443
OCPP_REQUIRE_AUTH=false
OCPP_TLS_CERT=/certs/server.crt
OCPP_TLS_KEY=/certs/server.key

# =====================================
# PWA (Next.js)
# =====================================
NEXT_PUBLIC_API_ENTRYPOINT=https://localhost
NEXT_PUBLIC_MERCURE_URL=https://localhost/.well-known/mercure

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=!ChangeThisNextAuthSecret!

# =====================================
# Keycloak (OIDC/OAuth2)
# =====================================
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_DB_PASSWORD=keycloak

# OIDC Client
OIDC_SERVER_URL=http://keycloak:8080/realms/bifrost
OIDC_SERVER_URL_INTERNAL=http://keycloak:8080/realms/bifrost
OIDC_CLIENT_ID=bifrost-pwa
OIDC_CLIENT_SECRET=

# =====================================
# pgAdmin
# =====================================
PGADMIN_EMAIL=admin@bifrost.local
PGADMIN_PASSWORD=bifrost

# =====================================
# Production Overrides
# (Uncomment and customize for production)
# =====================================
# APP_ENV=prod
# APP_DEBUG=0
# DATABASE_URL=postgresql://user:password@host:5432/database?serverVersion=16
# REDIS_PASSWORD=strongredispassword
# OCPP_REQUIRE_AUTH=true
